# QQMusicApi nginx 反向代理示例
#
# 安装（Debian/Ubuntu）:
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/QQMusicApi
#   sudo ln -s /etc/nginx/sites-available/QQMusicApi /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
# RHEL/CentOS 无 sites-enabled 机制，放入 /etc/nginx/conf.d/ 即可。
#
# ⚠ upstream 端口 3400 必须与网关的 PORT 环境变量保持一致（网关默认 PORT=3400）。
# ⚠ server_name 与证书路径需按实际环境修改。

server {
    listen 80;
    listen [::]:80;
    server_name example.com;   # [需修改] 域名或服务器 IP

    # ---- HTTPS（需要时取消注释并配置证书，例如 certbot 签发） ----
    # listen 443 ssl;
    # listen [::]:443 ssl;
    # ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;   # [需修改]
    # ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;     # [需修改]
    # ssl_protocols       TLSv1.2 TLSv1.3;

    # 请求体大小限制（JSON POST / 登录凭证提交等）
    client_max_body_size 10m;

    # 代理超时 60 秒
    proxy_connect_timeout 60s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;

    # 公共请求头（各 location 共用规则）
    # 注意：以下 location 均为「前缀匹配」，proxy_pass 不带 URI（无尾斜杠、无路径），
    # nginx 会原样透传完整请求路径，避免路径重写带来的歧义。
    location / {
        proxy_pass http://127.0.0.1:3400;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:3400;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /admin/ {
        proxy_pass http://127.0.0.1:3400;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
